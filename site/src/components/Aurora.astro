	.ribbon-2 { left: 18%; width: 5px; opacity: 0.5; animation: ribbon-shimmer-2 11s ease-in-out infinite alternate; }
	.ribbon-3 { left: 30%; width: 2px; opacity: 0.6; animation: ribbon-shimmer-1 9s ease-in-out 1s infinite alternate; }
